@model IEnumerable<HospitalManagement.Library.Models.Doctor>

<h2>Total Doctors</h2>

<a asp-action="Create" class="btn btn-primary">+Add New Patient</a>

<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>Doctor Number</th>

            <th>Full Name</th>

            <th>Specialization</th>

            <th>Phone Number</th>

            <th>Consultation Fee</th>

            @* <th>Created Date</th> *@

            <th>Action Button</th>

        </tr>

    </thead>

    <tbody>
        

            @foreach(var doctor in Model)
        {
            <tr>
                <td>@doctor.DoctorNumber</td>
                <td>@doctor.FullName</td>
                <td>@doctor.Specialization</td>
                <td>@doctor.PhoneNumber</td>
                <td>@doctor.ConsultationFee</td>
                @* <td>@doctor.CreatedDate</td> *@

                <td>
                    <a asp-action="Edit"
                    asp-route-id ="@doctor.DoctorId"
                    class="btn btn-warning btn-sm">
                       Edit
                    </a>

                    <form asp-action="Delete"
                            asp-route-id ="@doctor.DoctorId"
                            method="post"
                    style="display:inline;">

                    <button type="submit"
                        class="btn btn-danger btn-sm"
                        onclick="return confirm('Are you sure u want to delete this doctor?');">
                    Delete
                    </button>
                            
                        
                    </form>

                </td>
            </tr>
        }
        </tbody>

        </table>