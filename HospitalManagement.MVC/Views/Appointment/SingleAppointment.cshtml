@model HospitalManagement.Library.Models.Appointment

<h2>Appointment Details</h2>

<table class="table table-bordered">

<tr>
    <th>Appointment Number </th>
    <td>@Model.AppointmentNumber</td>

    <th>PatientID</th>
    <td>@Model.PatientId</td>

      <th>DoctorId</th>
    <td>@Model.DoctorId</td>

    <th>AppointmentDate </th>
    <td>@Model.AppointmentDate</td>

    <th>Status</th>
    <td>@Model.Status</td>

</tr>

</table>