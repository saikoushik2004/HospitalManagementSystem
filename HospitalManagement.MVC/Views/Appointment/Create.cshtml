@model HospitalManagement.Library.Models.Appointment

<h2>Add Appointment</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="AppointmentNumber" class="form-label"></label>
        <input asp-for="AppointmentNumber" class="form-control" />
        <span asp-validation-for="AppointmentNumber" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PatientId" class="form-label"></label>
        <input asp-for="PatientId" class="form-control" />
        <span asp-validation-for="PatientId" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DoctorId" class="form-label"></label>
        <input asp-for="DoctorId" class="form-control" />
        <span asp-validation-for="DoctorId" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AppointmentDate" class="form-label"></label>
        <input asp-for="AppointmentDate" class="form-control" />
        <span asp-validation-for="AppointmentDate" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-control">
            <option value="">--Select Status--</option>
            <option>Scheduled</option>
        </select>
    </div>


    <button type="submit" class="btn btn-primary">
        Save Appointment
    </button>

</form>