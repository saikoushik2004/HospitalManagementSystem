@* @model HospitalManagement.Library.Models.User; *@



@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="text-center mb-4">

            <div class="hospital-logo">
                🏥
            </div>

            <h2>
                KN Hospital
            </h2>

            <p class="text-muted">
                Login to continue
            </p>

        </div>


        <form asp-controller="Login"
              asp-action="LoginPro"
              method="post">

            <!-- Username -->

            <div class="mb-3">

                <label class="form-label">
                    Username
                </label>

                <input type="text"
                       name="username"
                       class="form-control"
                       placeholder="Enter username"
                       required />

            </div>


            <!-- Password -->

            <div class="mb-3">

                <label class="form-label">
                    Password
                </label>

                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter password"
                       required />

            </div>


            <!-- Error Message -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }


            <!-- Login Button -->

            <div class="d-grid">

                <button type="submit"
                        class="btn btn-primary btn-lg">

                    Login

                </button>

            </div>

        </form>

    </div>

</div>