@model HospitalManagement.Library.Models.Patient

@{
    ViewData["Title"] = "Edit Patient";
}

<h2>Edit Patient</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="PatientId" />

    <div class="mb-3">
        <label asp-for="PatientNumber"></label>
        <input asp-for="PatientNumber" class="form-control" />
        <span asp-validation-for="PatientNumber" class="text-danger"></span>

    </div>

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>

    </div>

    
    <div class="mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" class="form-control">
            <option value="">--Select Gender--</option>
            <option>Male</option>
            <option>Female</option>
            <option>Other</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-bg-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>

    </div>

    <input type="hidden" asp-for="CreatedDate" />

    <button type="submit" class="btn btn-primary">
        Update Patient
    </button>

    <a asp-action="TotalPatients" class="btn btn-secondary">
        Cancel
    </a>

</form>
































