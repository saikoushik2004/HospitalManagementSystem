@model HospitalManagement.Library.Models.Patient

<h2>Patient Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Patient Number</th>
        <td>@Model.PatientNumber</td>
    </tr>

    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Gender</th>
        <td>@Model.Gender</td>
    </tr>

    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>

    <tr>
        <th>Phone Number</th>
        <td>@Model.PhoneNumber</td>
    </tr>

    <tr>
        <th>Address</th>
        <td>@Model.Address</td>
    </tr>

</table>

<a asp-action="TotalPatients" class="btn btn-secondary">
    Back to List
</a>